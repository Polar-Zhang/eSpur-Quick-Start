# 示例仅用于规划；先核对目标主机已有接口和路由，不要直接覆盖。
# 北京已有自有 wg0；eSpur hub 使用独立 espur-wg0。
[Interface]
Address = <此节点已分配的mesh地址及前缀>
PrivateKey = <只在本机生成并保管的私钥>
MTU = <按节点和链路核定的MTU>

[Peer]
PublicKey = <已核验的eSpur-hub公钥>
Endpoint = <已核验的eSpur-hub地址>:51822
# 每个节点按自身路由需要设置；不得把本地 PDU 网段盲目指向隧道。
AllowedIPs = <已核验的网段>
PersistentKeepalive = 25
